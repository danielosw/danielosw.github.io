{
  "name": "danielosw.github.io",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "update-browserslist": "update-browserslist-db"
  },
  "devDependencies": {
    "@csstools/postcss-oklab-function": "^5.0.16",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.11",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^4.1.12",
    "autoprefixer": "^10.6.2",
    "caniuse-lite": "^1.0.30001826",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "postcss-calc": "^10.1.1",
    "postcss-import": "^16.2.0",
    "postcss-mixins": "^12.1.2",
    "postcss-preset-env": "^11.6.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "update-browserslist-db": "^1.3.4",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "vitest-browser-svelte": "^3.1.0"
  }
}