{
  "name": "danielosw.github.io",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0 <12.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "test:unit": "vitest",
    "test": "pnpm run test:unit -- --run",
    "update-browserslist": "update-browserslist-db"
  },
  "devDependencies": {
    "@csstools/postcss-oklab-function": "^5.0.15",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "^5.0.5",
    "autoprefixer": "^10.6.2",
    "caniuse-lite": "^1.0.30001819",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "postcss-calc": "^11.2.3",
    "postcss-import": "^17.0.1",
    "postcss-mixins": "^12.1.2",
    "postcss-preset-env": "^11.6.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "update-browserslist-db": "^1.3.4",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0"
  }
}
