{
  "name": "danielosw.github.io",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0 <12.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "test:unit": "vitest",
    "test": "pnpm run test:unit -- --run",
    "update-browserslist": "update-browserslist-db"
  },
  "devDependencies": {
    "@csstools/postcss-oklab-function": "^5.0.10",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.13.3",
    "@vitest/browser-playwright": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "caniuse-lite": "^1.0.30001810",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.28",
    "postcss-calc": "^10.1.1",
    "postcss-import": "^16.2.0",
    "postcss-mixins": "^12.1.2",
    "postcss-preset-env": "^11.5.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "update-browserslist-db": "^1.3.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-browser-svelte": "^3.0.0"
  }
}
